# ===================================================
# PSYSCAN AI - Full-Stack Environment Configuration (.env.example)
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MySQL 8+ / PlanetScale / AWS RDS / TiDB)
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>?sslaccept=strict
DATABASE_URL="mysql://root:password@localhost:3306/psyscan_db"

# JWT Authentication Secrets
JWT_SECRET="psyscan-super-secure-jwt-secret-key-2026-prod"
JWT_REFRESH_SECRET="psyscan-super-secure-refresh-jwt-secret-key-2026"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# AI Provider Configuration ('mock' | 'gemini' | 'openai')
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL="gemini-1.5-flash"

# CORS & Allowed Frontend URLs (comma-separated or single domain)
# Set this to your deployed Vercel frontend URL
FRONTEND_URL="https://psyscan-frontend.vercel.app"
CORS_ORIGIN="https://psyscan-frontend.vercel.app"
