# ==========================================
# PSYSCAN AI - Environment Configuration
# ==========================================

# Server Port
PORT=5000
NODE_ENV=development

# Database Connection (MySQL 8+)
DATABASE_URL="mysql://root:password@localhost:3306/psyscan_ai"

# JWT Authentication
JWT_SECRET="psyscan-super-secure-jwt-secret-key-2026-prod"
JWT_REFRESH_SECRET="psyscan-super-secure-refresh-jwt-secret-key-2026"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# AI Provider Configuration ('mock' | 'gemini' | 'openai')
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL="gemini-1.5-flash"

# URLs & CORS
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"
